# Zoya (web) — copy to .env.local and fill in.
#
# Only used by the two server routes (server/handlers.mjs). The browser never
# sees this value: it receives a single-use ephemeral token instead.
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-3.1-flash-live-preview).
# ZOYA_MODEL=gemini-3.1-flash-live-preview

# Optional: port for `npm start` (production server).
# PORT=8080
