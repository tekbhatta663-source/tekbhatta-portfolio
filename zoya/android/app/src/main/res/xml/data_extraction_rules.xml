<?xml version="1.0" encoding="utf-8"?>
<!-- Zoya keeps no transcripts. Nothing worth backing up, nothing to leak. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
