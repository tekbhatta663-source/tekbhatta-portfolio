#!/bin/sh
# Minimal Gradle wrapper.
#
# The usual wrapper JAR is a binary blob committed to git; this script fetches
# the matching distribution itself so nothing opaque ships in the repo. If you
# have Gradle installed, `gradle wrapper` will regenerate the conventional files.
set -e

APP_HOME=$(cd "$(dirname "$0")" && pwd)
GRADLE_VERSION=8.11.1
DIST_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
CACHE_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/zoya-${GRADLE_VERSION}"
GRADLE_BIN="$CACHE_DIR/gradle-${GRADLE_VERSION}/bin/gradle"

if [ ! -x "$GRADLE_BIN" ]; then
  echo "Downloading Gradle ${GRADLE_VERSION}..." >&2
  mkdir -p "$CACHE_DIR"
  TMP_ZIP="$CACHE_DIR/gradle.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$DIST_URL" -o "$TMP_ZIP"
  else
    wget -q "$DIST_URL" -O "$TMP_ZIP"
  fi
  (cd "$CACHE_DIR" && unzip -q -o gradle.zip && rm -f gradle.zip)
fi

exec "$GRADLE_BIN" --project-dir "$APP_HOME" "$@"
